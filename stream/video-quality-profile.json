{
  "daily_publish_target": 3,
  "youtube_minimum_duration_seconds": 180,
  "youtube_format": "normal educational landscape video",
  "youtube_shorts_allowed": false,
  "short_vertical_usage": "X replies or explicitly requested non-YouTube social clips only",
  "daily_package": [
    "educational challenge and result episode",
    "educational training or experiment episode",
    "educational lesson, failure analysis, or evaluation episode"
  ],
  "landscape": {
    "width": 2560,
    "height": 1440,
    "fps": 60
  },
  "vertical_short": {
    "width": 1440,
    "height": 2560,
    "fps": 60
  },
  "encoding": {
    "video_codec": "libx264",
    "profile": "high",
    "pixel_format": "yuv420p",
    "crf": 16,
    "preset": "slow",
    "audio_codec": "aac",
    "audio_sample_rate_hz": 48000,
    "audio_bitrate": "192k"
  },
  "source_rules": {
    "native_resolution_required": true,
    "upscaled_720p_allowed": false,
    "full_playback_qa_required": true,
    "moving_simulator_footage_required": true,
    "runtime_padding_allowed": false
  },
  "minimum_free_disk_gb_for_rendering": 20
}
